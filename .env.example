APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Резервные курсы, если frankfurter.app недоступен
EUR_TO_MDL=19.30
USD_TO_MDL=17.50

# --- DealWatch (полный список: config/dealwatch.php) ---
# Экономика сделки
DEALWATCH_PREP_COST=300
DEALWATCH_RISK_RESERVE=300
DEALWATCH_MIN_PROFIT=1500

# Рынок: потолок и «забирать сразу» в долях от mid
DEALWATCH_BUY_MAX_RATIO=0.82
DEALWATCH_BUY_MIN_RATIO=0.70
DEALWATCH_MARKET_MIN_SAMPLES=5
DEALWATCH_EVIDENCE_CACHE_MINUTES=60
# 0 — считать счётчики ленты на каждый запрос (в тестах так и делается)
DEALWATCH_STATS_CACHE_SECONDS=60

# Продавцы: сколько активных объявлений делают аккаунт перекупом
DEALWATCH_RESELLER_THRESHOLD=3

# Сбор с 999.md
DEALWATCH_COLLECT_LIMIT=40
DEALWATCH_COLLECT_ENRICH=true
DEALWATCH_COLLECT_ENRICH_NEW_ONLY=true
DEALWATCH_EMPTY_RUNS_BEFORE_ALERT=3

# OpenAI: ключ и две модели (дешёвая скринит пачку, дорогая разбирает финалистов).
# Цены — доллары за 1M токенов, нужны только для учёта расходов.
OPENAI_API_KEY=
DEALWATCH_AI_ENABLED=true
OPENAI_MODEL_SCREEN=gpt-5-mini
OPENAI_MODEL_SCREEN_INPUT_PRICE=0.25
OPENAI_MODEL_SCREEN_OUTPUT_PRICE=2.00
OPENAI_MODEL_DEEP=gpt-5
OPENAI_MODEL_DEEP_INPUT_PRICE=1.25
OPENAI_MODEL_DEEP_OUTPUT_PRICE=10.00
OPENAI_MODEL_VISION=gpt-5
DEALWATCH_AI_VISION_ENABLED=false
DEALWATCH_AI_VISION_MAX_IMAGES=4
DEALWATCH_AI_BATCH_SIZE=40
DEALWATCH_AI_CACHE_HOURS=24
DEALWATCH_AI_DAILY_CALLS=200
DEALWATCH_AI_DAILY_COST_USD=5.0

# Самостоятельная регистрация (лента общая для всех аккаунтов)
DEALWATCH_ALLOW_REGISTRATION=false
